# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
# Optional: used by scripts/apply_slack_manifest.py
SLACK_APP_ID=
SLACK_APP_CONFIG_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# OpenAI (analysis, script, optional TTS)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Podcastfy TTS: openai | edge
PODCASTFY_TTS_MODEL=openai

# Google Drive — personal Gmail needs user OAuth (service accounts have no Drive quota).
GOOGLE_OAUTH_CLIENT_FILE=./credentials/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=./credentials/google-oauth-token.json
GOOGLE_DRIVE_FOLDER_ID=
# Optional leftover; cannot upload on personal Drive:
# GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json

# Notion internal integration. Share a parent page with the integration.
NOTION_TOKEN=ntn_...
NOTION_PARENT_PAGE_ID=

# Demo cache
DEMO_MODE=true
FORCE_REGENERATE=false

# Optional tuning
REQUEST_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180
PODCASTFY_TIMEOUT_SECONDS=600
MAX_VIDEOS=5
